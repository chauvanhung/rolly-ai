http://calendar.rollyhub.com {
  encode gzip zstd
  import shared_security_headers
  import calendar_csp

  handle /api/* {
    reverse_proxy backend:8000
  }

  handle /health {
    reverse_proxy calendar_frontend:80
  }

  handle {
    reverse_proxy calendar_frontend:80
  }
}

# Cấu hình mặc định cho app.rollyhub.com, localhost, và IP trực tiếp
:80 {
  encode gzip zstd
  import shared_security_headers
  import app_csp

  handle /api {
    reverse_proxy backend:8000
  }

  handle /api/* {
    reverse_proxy backend:8000
  }

  handle /docs {
    reverse_proxy backend:8000
  }

  handle /docs/* {
    reverse_proxy backend:8000
  }

  handle /redoc {
    reverse_proxy backend:8000
  }

  handle /redoc/* {
    reverse_proxy backend:8000
  }

  handle /openapi.json {
    reverse_proxy backend:8000
  }

  handle /health {
    reverse_proxy backend:8000
  }

  handle /lingua-api/* {
    uri replace /lingua-api /api
    reverse_proxy host.docker.internal:8011
  }

  handle /lingua-uploads/* {
    uri replace /lingua-uploads /uploads
    reverse_proxy host.docker.internal:8011
  }

  handle /lingua {
    reverse_proxy host.docker.internal:3011
  }

  handle /lingua/* {
    reverse_proxy host.docker.internal:3011
  }

  handle {
    reverse_proxy frontend:80
  }
}

