http://word.rollyhub.com {
  encode gzip zstd
  import shared_security_headers
  import word_csp

  handle {
    reverse_proxy host.docker.internal:5055
  }
}



http://phatgiao.rollyhub.com {
  encode gzip zstd
  import shared_security_headers
  import phatgiao_csp

  handle /api/* {
    reverse_proxy host.docker.internal:8015
  }

  handle /health {
    reverse_proxy host.docker.internal:8015
  }

  handle {
    reverse_proxy host.docker.internal:3015
  }
}
